# Copy to .env and fill in. docker-compose.yml reads these values.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=grid
POSTGRES_PASSWORD=change-me
# Host "db" is the compose service name
CONNECTION_STRING=Host=db;Port=5432;Database=grid;Username=grid;Password=change-me

# ── Email (Mailgun) — required outside Development ──────────────────────────
MAILGUN_API_KEY=

# ── External login providers (optional) ─────────────────────────────────────
# A provider is enabled only when all of its values are set.
# Redirect URIs to register with each provider:
#   Google     https://<your-domain>/signin-google
#   Microsoft  https://<your-domain>/signin-microsoft
#   Authentik  https://<your-domain>/signin-authentik

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Issuer URL of the Authentik OAuth2/OpenID provider, e.g.
# https://auth.example.com/application/o/grid/
AUTHENTIK_AUTHORITY=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Registry prefix for the built image, including trailing slash
DOCKER_REGISTRY=
