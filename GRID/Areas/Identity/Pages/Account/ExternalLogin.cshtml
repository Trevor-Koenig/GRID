@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-bg">
    <img src="~/images/hero/bannerDarkReduced.webp" class="dark-theme auth-bg-img" alt="">
    <img src="~/images/hero/bannerLightReduced.webp" class="light-theme auth-bg-img" alt="">
    <div class="auth-bg-overlay"></div>
    <div class="auth-card-wrapper">
        <div class="auth-card">
            <a href="/" class="auth-logo">
                <h1 class="sitename">GRID<span>.</span></h1>
            </a>
            <h2>Finish creating your account</h2>
            <p class="text-muted">
                You've signed in with <strong>@Model.ProviderDisplayName</strong>, but it isn't linked to a GRID account yet.
                Enter your invite code to create one.
            </p>
            @if (Model.EmailAlreadyRegistered)
            {
                <div class="alert alert-info" role="alert">
                    An account with this email already exists.
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a> with your password, then link
                    @Model.ProviderDisplayName from <strong>Manage account &rsaquo; External Logins</strong>.
                </div>
            }
            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.InviteCode" class="form-control" aria-required="true" placeholder="XXXXXXXX" />
                    <label asp-for="Input.InviteCode">Invite Code</label>
                    <span asp-validation-for="Input.InviteCode" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary mb-3">Register</button>
                <div>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="d-block py-2 fs-5 fs-sm-6">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
